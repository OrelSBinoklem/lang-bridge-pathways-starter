      "kind": "application",
      "binding": {
        "engine": "tutor_flow",
        "key": "tutor"
      },
      "inputs": [
        {
          "id": "chat_event",
          "label": "Сообщение / голос"
        },
        {
          "id": "summary_context",
          "label": "Резюме в контекст"
        },
        {
          "id": "reference_chat_result",
          "label": "Результат поиска"
        },
        {
          "id": "dialogue_restore",
          "label": "Восстановить контекст"
        }
      ],
      "outputs": [
        {
          "id": "compress_dialogue",
          "label": "Сжать переписку"
        },
        {
          "id": "chat_reference",
          "label": "web.reference"
        },
        {
          "id": "dialogue_store",
          "label": "Сообщения и состояния"
        }
      ]
    },
    {
      "id": "memory",
      "name": "Память диалогов",
      "icon": "pi-database",
      "colour": "#008b83",
      "roles": [
        "dialogue_summary",
        "daily_summary"
      ],
      "position": {
        "x": 1020,
        "y": 0
      },
      "kind": "application",
      "binding": {
        "engine": "service_workflow",
        "key": "memory"
      },
      "inputs": [
        {
          "id": "daily_memory_event",
          "label": "Суточное резюме"
        },
        {
          "id": "compress_dialogue",
          "label": "Сжать переписку"
        }
      ],
      "outputs": [
        {
          "id": "summary_context",
          "label": "Резюме в контекст"
        },
        {
          "id": "memory_store",
          "label": "Резюме и память"
        }
      ]
    },
    {
